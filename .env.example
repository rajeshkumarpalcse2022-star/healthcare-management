# Copy this file to .env.local and fill in your own values.
# Never commit .env.local.

# Required. Server-side only - never exposed to the browser.
# Local:  mongodb://127.0.0.1:27017/healthcare_management
# Atlas:  mongodb+srv://<user>:<password>@<cluster>/<db>?retryWrites=true&w=majority
MONGODB_URI=

# Required for authentication (session signing). Server-side only - never
# exposed to the browser. Only read when authentication code actually runs.
# Generate a strong value, e.g.:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
AUTH_SECRET=

# Optional Cloudinary image uploads. Server-side only - the API secret must
# never be prefixed with NEXT_PUBLIC_ or exposed to the browser.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
