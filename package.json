{
  "name": "healthcare-management-platform",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test:step7": "node --experimental-strip-types --import ./scripts/step7/register.mjs scripts/step7/offline-contract-tests.mjs",
    "test:step7:live": "node --experimental-strip-types --import ./scripts/step7/register.mjs scripts/step7/live-contract-tests.mjs",
    "test:step8": "node --experimental-strip-types --import ./scripts/step8/register.mjs scripts/step8/offline-contract-tests.mjs",
    "test:step9": "node --experimental-strip-types --import ./scripts/step9/register.mjs scripts/step9/offline-contract-tests.mjs",
    "test:review:live": "node --experimental-strip-types --import ./scripts/step7/register.mjs scripts/step7/review-workflow-live-tests.mjs",
    "test:step10": "node --conditions=react-server --experimental-strip-types --import ./scripts/step8/register.mjs scripts/step10-smoke.mjs",
    "test": "npm run test:step7 && npm run test:step8 && npm run test:step9 && npm run test:step10"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "clsx": "^2.1.1",
